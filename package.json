{
  "name": "frame",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @frame/web run dev",
    "build": "pnpm --filter @frame/web run build",
    "lint": "pnpm --filter @frame/web run lint",
    "typecheck": "pnpm --filter @frame/web run typecheck",
    "test": "pnpm --filter @frame/web run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "pnpm --filter @frame/api run dev",
    "api:build": "pnpm --filter @frame/api run build",
    "api:start": "pnpm --filter @frame/api run start",
    "api:test": "pnpm --filter @frame/api run test",
    "api:typecheck": "pnpm --filter @frame/api run typecheck",
    "api:lint": "pnpm --filter @frame/api run lint",
    "test:transport": "pnpm run api:build && node --test tests/transport/transport.test.cjs",
    "db:init": "node apps/api/scripts/database.cjs init",
    "db:up": "node apps/api/scripts/database.cjs up",
    "db:down": "node apps/api/scripts/database.cjs down",
    "db:status": "node apps/api/scripts/database.cjs status",
    "db:migrate": "node apps/api/scripts/database.cjs migrate",
    "db:migrate:status": "node apps/api/scripts/database.cjs status-migrations",
    "db:diff": "node apps/api/scripts/database.cjs diff",
    "db:test": "pnpm run api:build && node apps/api/scripts/database.cjs test",
    "prisma:validate": "pnpm --filter @frame/api run prisma:validate",
    "prisma:generate": "pnpm --filter @frame/api run prisma:generate",
    "contracts:build": "pnpm --filter @frame/contracts run build",
    "contracts:test": "pnpm --filter @frame/contracts run test",
    "contracts:typecheck": "pnpm --filter @frame/contracts run typecheck",
    "contracts:lint": "pnpm --filter @frame/contracts run lint",
    "openapi:generate": "pnpm --filter @frame/contracts run openapi:generate",
    "openapi:check": "pnpm --filter @frame/contracts run openapi:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.34.9"
}
