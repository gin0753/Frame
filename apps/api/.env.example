NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Optional, server-only. Omit for liveness-only operation (readiness returns 503).
# DATABASE_URL=<PostgreSQL connection URL supplied by the operator>
# Local random credentials/URLs: pnpm run db:init (see README; no implicit loading).

# Internal provider only; false permits credential-free health/web/tests.
TMDB_ENABLED=false
# Required only when TMDB_ENABLED=true. Private API Read Access Token, not an API key.
# TMDB_READ_ACCESS_TOKEN=<operator-supplied API Read Access Token>

# Catalog-only coalescing bounds. Retained provider content remains legally gated.
# Setting CATALOG_CACHE_ENABLED=true currently fails startup pending rights review.
CATALOG_CACHE_ENABLED=false
CATALOG_MAX_INFLIGHT=32
CATALOG_MAX_CONSUMERS=128
CATALOG_CACHE_MAX_ENTRIES=128
CATALOG_CACHE_MAX_BYTES=4194304
# TTLs default to zero; these settings do not override the rights gate.
CATALOG_CACHE_TRENDING_TTL_SECONDS=0
CATALOG_CACHE_POPULAR_TTL_SECONDS=0
CATALOG_CACHE_GENRES_TTL_SECONDS=0
CATALOG_CACHE_DETAIL_TTL_SECONDS=0
CATALOG_CACHE_CONFIGURATION_TTL_SECONDS=0
