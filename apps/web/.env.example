# Copy to apps/web/.env.local for a LOCAL API preview with the Nest health API.
# Next loads env files from apps/web, not the monorepo root or src directory.
# Disabled by default: the fixture Homepage needs no API.
FRAME_LOCAL_API_PROXY=false

# Trusted server-only origin, without /api/v1. Never use NEXT_PUBLIC_* or next.config env.
# With the local proxy enabled, only loopback HTTP(S) origins are accepted.
FRAME_API_ORIGIN=http://127.0.0.1:3001

# Set FRAME_LOCAL_API_PROXY=true explicitly for local proxy development/previews.
# Rebuild production previews after changing rewrite settings; restart next dev.
# Deployment ingress owns /api/v1 routing: leave the local proxy disabled there.
# No API credentials, database or session settings are needed in Stage 1.2.
